# Server display name shown in the server browser
SERVER_NAME=Morass Roleplay

# Helix schema gamemode folder name (must match gamemodes/<name>/)
GAMEMODE=morass

# Starting map — use gm_construct for testing; swap to your RP map when ready
MAP=gm_construct

# Network port (UDP + TCP game port)
PORT=27015

# Player cap
MAXPLAYERS=32

# Set to 1 for live servers (disables Lua hot-reload)
PRODUCTION=0

# Steam Game Server Login Token — required for public listing
# Create one at https://steamcommunity.com/dev/managegameservers
GSLT=

# Extra srcds arguments (workshop collection, tickrate, etc.)
# Example: +host_workshop_collection 123456789 +tickrate 22
SERVER_ARGS=

# Auto-update GMod via Steam on container start
AUTOUPDATE=1

# Match container user to host user for bind-mount permissions (Linux)
PUID=1000
PGID=1000
